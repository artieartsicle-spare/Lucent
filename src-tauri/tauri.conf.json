{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lucent",
  "version": "0.1.0",
  "identifier": "com.lucent.app",
  "build": {
    "beforeDevCommand": "npm run overlay:dev",
    "devUrl": "http://127.0.0.1:5174",
    "beforeBuildCommand": "npm run overlay:build",
    "frontendDist": "../dist-overlay"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
